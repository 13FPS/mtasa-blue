<?xml version="1.0" encoding="utf-8"?>
<!-- This explicit diagnostic configuration exercises MTA's existing configured
     bind loader without introducing unrelated defaults or modifying user binds.
     Right Shift keeps walk eligible while the bounded poll skips ambiguous Alt. -->
<mainconfig>
    <binds>
        <bind key="w" control="forwards" />
        <bind key="s" control="backwards" />
        <bind key="a" control="left" />
        <bind key="d" control="right" />
        <bind key="lshift" control="sprint" />
        <bind key="rshift" control="walk" />
    </binds>
</mainconfig>
